{
  "manifest_version": 3,
  "name": "Facelift for YouTube",
  "version": "1.2.0",
  "description": "A calmer YouTube layout. Hide Shorts, Playables and selected buttons without changing the player or your subscriptions.",
  "browser_specific_settings": {
    "gecko": {
      "id": "facelift-for-youtube@extensions.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png", "32": "icons/32.png",
    "48": "icons/48.png", "128": "icons/128.png"
  },
  "action": {
    "default_title": "Facelift for YouTube",
    "default_popup": "popup/index.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "content_scripts": [{
    "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
    "run_at": "document_start",
    "css": ["content/styles.css"],
    "js": ["content/index.js"]
  }],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
